<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- Linker Bereich: Name + Intervall -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvReminderName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Erinnerung"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#212121" />

            <TextView
                android:id="@+id/tvReminderInterval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Alle 5 Minuten"
                android:textSize="13sp"
                android:textColor="#757575"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvReminderFile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Keine Datei"
                android:textSize="12sp"
                android:textColor="#9E9E9E"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- An/Aus Schalter -->
        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchEnabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp" />

        <!-- Bearbeiten-Button -->
        <ImageButton
            android:id="@+id/btnEdit"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_edit"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Bearbeiten"
            android:layout_marginStart="4dp" />

        <!-- Löschen-Button -->
        <ImageButton
            android:id="@+id/btnDelete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Löschen"
            android:layout_marginStart="2dp" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
